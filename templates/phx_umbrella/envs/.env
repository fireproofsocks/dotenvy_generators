# envs/.env (default/shared config)
# Values here are shared by all environments. Environment-specific files
# (.dev.env, .test.env, .prod.env) are sourced after this one and win.

# ###################
# Distributed Node  #
# ###################
# If set, the app will query this DNS name to discover cluster peers.
# Leave empty to run as a single node.
DNS_CLUSTER_QUERY=

# #####################
# Phoenix / Webserver #
# #####################
# The interface(s) to listen on.
# `1.2.3.4` for IPv4 addresses (using period separators)
# `1:2:3:4:5:6:7:8` for IPv6 addresses (using colon separators)
#
# To bind to loopback IPv4 address & prevent access from other machines: `127.0.0.1`
# To allow access from other machines: `0.0.0.0`
#
# To enable IPv6 and bind on all interfaces: `0:0:0:0:0:0:0:0` (or `::`)
# For local network only access: `0:0:0:0:0:0:0:1` (or `::1`)
#
# The `:ip!` type accepts compressed IPv6 forms, but rejects abbreviated IPv4
# forms such as `127.1`, so write all four octets. A blank value raises.
HTTP_INTERFACE=127.0.0.1
# Port where HTTP requests will be accepted
PORT=4000
# A secret used to sign and encrypt cookies and other secrets.
# Generate one with `mix phx.gen.secret`. Must be set per application.
SECRET_KEY_BASE=
# Boolean indicating whether to start the Phoenix webserver.
# Usually false for dev/test and true for prod releases.
PHX_SERVER=false
